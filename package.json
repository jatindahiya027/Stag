{
  "name": "stag",
  "version": "0.1.0",
  "description": "Stag — Design Asset Manager",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -n renderer,electron -c cyan,yellow \"vite --port 3000\" \"wait-on tcp:3000 -t 30000 && electron .\"",
    "dev:renderer": "vite --port 3000",
    "dev:electron": "wait-on tcp:3000 && electron .",
    "build": "vite build",
    "postinstall": "electron-builder install-app-deps",
    "test": "npm run test:code && npm run test:library && npm run test:ai && npm run test:layout && npm run test:media && npm run test:python && npm run test:native",
    "test:code": "tsc --noEmit --noUnusedLocals --noUnusedParameters && node scripts/audit-code-health.js",
    "test:library": "node scripts/audit-library-management-contracts.js",
    "test:ai": "node scripts/audit-ai-contracts.js && node scripts/audit-ai-storage-contracts.js && node scripts/test-ai-task-coordinator.js && python3 -m unittest AI-index/test_dinov3_incremental.py AI-index/test_tipsv2_manifest.py",
    "test:layout": "node scripts/audit-layout-contracts.js",
    "test:media": "node scripts/audit-media-contracts.js",
    "test:python": "node scripts/audit-python-runtime-contracts.js",
    "test:native": "node scripts/audit-native-dependency-contracts.js && node scripts/audit-windows-installer-contracts.js && node scripts/test-electron-sqlite.js",
    "electron:rebuild": "electron-rebuild -f -w better-sqlite3",
    "prepare:python": "node scripts/prepare-python-runtime.js",
    "validate:python": "node scripts/validate-python-runtime.js",
    "prepare:ffmpeg": "node scripts/prepare-ffmpeg.js",
    "validate:ffmpeg": "node scripts/validate-ffmpeg-runtime.js",
    "prepare:poppler:mac": "node scripts/prepare-poppler.js darwin-arm64 darwin-x64",
    "prepare:poppler:win": "node scripts/prepare-poppler.js win32-x64 win32-arm64",
    "dist:mac:arm64": "node scripts/prepare-native-deps.js darwin-arm64 && node scripts/prepare-poppler.js darwin-arm64 && npm run build && electron-builder --mac --arm64",
    "dist:mac:x64": "node scripts/prepare-native-deps.js darwin-x64 && node scripts/prepare-poppler.js darwin-x64 && npm run build && electron-builder --mac --x64",
    "dist:win:x64": "node scripts/prepare-native-deps.js win32-x64 && node scripts/prepare-poppler.js win32-x64 && npm run build && electron-builder --win --x64",
    "dist:win:arm64": "node scripts/prepare-native-deps.js win32-arm64 && node scripts/prepare-poppler.js win32-arm64 && npm run build && electron-builder --win --arm64",
    "dist:win": "npm run dist:win:x64",
    "dist:mac": "npm run dist:mac:arm64"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "electron": "41.7.2",
    "electron-builder": "^26.15.3",
    "tar": "^7.5.16",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@fiahfy/icns": "^0.0.7",
    "@tanstack/react-virtual": "^3.14.2",
    "adm-zip": "^0.5.17",
    "better-sqlite3": "12.10.0",
    "epubjs": "^0.3.93",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "heic-convert": "^2.1.0",
    "jimp": "^1.6.1",
    "lucide-react": "^1.18.0",
    "mpegts.js": "^1.8.0",
    "pino": "^10.3.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.35.1",
    "xml2js": "^0.6.2",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "epubjs": {
      "@xmldom/xmldom": "0.8.13"
    }
  },
  "build": {
    "appId": "com.stag.app",
    "productName": "Stag",
    "executableName": "Stag",
    "copyright": "Copyright © 2025 Stag",
    "npmRebuild": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asarUnpack": [
      "AI-index/tipsv2_search.py",
      "AI-index/dinov3_search.py",
      "node_modules/better-sqlite3/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "AI-index/tipsv2_search.py",
      "AI-index/dinov3_search.py",
      "node_modules/**/*",
      "!node_modules/ffmpeg-static/**/*",
      "!node_modules/ffprobe-static/**/*",
      "!node_modules/@napi-rs/canvas/**/*",
      "!node_modules/@napi-rs/canvas-*/**/*",
      "build/**/*",
      "public/**/*"
    ],
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.graphics-design",
      "extraResources": [
        {
          "from": "resources/poppler/darwin-${arch}",
          "to": "poppler"
        }
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "resources/poppler/win32-${arch}",
          "to": "poppler"
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "afterPack": "./scripts/electron-builder-hooks.js",
    "nsis": {
      "artifactName": "${productName}-${version}-${arch}-Setup.${ext}",
      "oneClick": false,
      "differentialPackage": false,
      "useZip": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Stag",
      "include": "build/installer.nsh"
    }
  },
  "productName": "Stag"
}
